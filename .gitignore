# Базы данных: hunter.db раздувался до 343 МБ (2.5 млн строк opportunities),
# в историю git не годится. Данные экспериментов и paper-прогонов
# воспроизводимы, историю хранить не нужно.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Резервные копии разных сборок engine.py (~23 500 строк). Именно в них
# сохранились потерянные Hunter/Telegram/Database, но как исторический хвост
# они в git не нужны.
old/

# Артефакты выполнения
__pycache__/
*.py[cod]
.pytest_cache/
logs/
*.log
*.err
simulator/

# Секреты
.env

# Окружение
venv/
.venv/

# Временные отладочные скрипты замеров (_*.py, _*.txt).
# Один такой (_fx4.py) попал в коммит 3960a88 - коммит откачен.
_*.py
_*.txt

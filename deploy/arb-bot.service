[Unit]
Description=Arbitrage Cash-and-Carry Bot (paper mode)
Documentation=file:///home/user/arbitr/deploy/README_HIVE.md

# ЗАЧЕМ After=network.target, а не hive.service
#
# В инструкции предлагалось "After=network.target hive.service". Проверил
# код и историю Hive OS: hive.service - это СЕРВИС МАЙНЕРА (он же
# инициализирует GPU). Зависимость от него тут бессмысленна и даже
# вредна: бот не использует GPU вообще, он сетевой. А на части прошивок
# Hive OS юнита с таким именем просто нет, и systemd ругается в лог при
# каждой загрузке ("Unit hive.service not found") - то есть лишний шум
# в самый момент старта.
#
# Нужна только сеть. И ВАЖНО: не просто "сеть поднялась", а прошёл
# успешный опрос DNS - без этого бот стартует, не находит биржи и
# сразу падает. Restart=always это переживёт, но пара лишних рестартов
# в логе на каждой загрузке - это ровно тот сигнал, который заглушает
# настоящую аварию.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/arbitr
ExecStart=/home/user/arbitr/deploy/run_bot.sh

# ВАЖНО: не on-failure, как в исходной инструкции.
# Бот завершается возвратом из main() и ВСЕГДА отдаёт код 0 - даже
# после падения. При on-failure systemd считает это успехом и не
# перезапустит: бот молча умрёт, а риг продолжит считать, что всё
# работает. Поэтому always + защита от "долгой" штатной остановки
# в скрипте запуска.
Restart=always
RestartSec=15

# Ограничиваем бесконечные рестарты: если бот падает каждые 15 секунд,
# 10 попыток за 5 минут - и systemd сдаётся, оставляя сервис в failed.
# Так мы УВИДИМ проблему вместо того, чтобы её замаскировать бесконечным
# рестартом и истрепать логи.
StartLimitBurst=10
StartLimitIntervalSec=300

# Штатная остановка: у бота свой обработчик SIGTERM, который гасит
# задачи и пишет состояние портфеля. Без KillSignal он получил бы
# SIGKILL за 90 секунд и не успел бы сохранить состояние - то есть
# после перезагрузки рига открытые пары потеряли бы таймауты.
KillSignal=SIGTERM
TimeoutStopSec=60

# Переменные окружения рига. Бот читал их из .env, который в .gitignore;
# на ферме .env тоже будет, но задать их в сервисе надёжнее: значения
# видны в systemctl show, и их нельзя случайно затереть деплоем.
# ВНИМАНИЕ: не вставляйте сюда секреты Telegram-токена в открытом виде,
# если systemctl доступен другим пользователям рига.
# Environment=TRADING_MODE=paper
# Environment=TELEGRAM_TOKEN=...

# Аппаратные ресурсы. Бот - сетевой и однопоточный по сути (asyncio),
# но держит до 800 символов в памяти. Ограничиваем, чтобы на ферме
# с майнером бот не вытеснил его по RAM - риг дорогой, а прогон
# можно перезапустить.
MemoryMax=1500M
MemoryHigh=1200M
# CPU: 4 ядра на 24 потока - этого достаточно с запасом, при этом
# майнер не ощутит. Понижаем Nice, чтобы при нехватке CPU вытеснился
# бот, а не горячая точка.
CPUWeight=50
Nice=10

# Только фатальные случаи, не дампы ядра: бот - обычный процесс.
OOMPolicy=kill

# Безопасность: сервису не нужно ни root, ни доступ к устройствам.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Запись нужна только в рабочий каталог (hunter.db, logs/)
ReadWritePaths=/home/user/arbitr

[Install]
WantedBy=multi-user.target
